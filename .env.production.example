# Copy this file to .env.production on the server and replace every placeholder.
# Never commit .env.production.

DASHBOARD_DOMAIN=sitewatch-dashboard.com
API_DOMAIN=api.sitewatch-dashboard.com
ACME_EMAIL=replace-with-certificate-contact-email

SITEWATCH_DATA_ROOT=/mnt/HC_Volume_107250753/sitewatch

MSSQL_DATABASE=SiteWatch
# Express is production-licensed but limited. Use Developer only for non-production testing.
MSSQL_PID=Express
MSSQL_SA_PASSWORD=replace-with-a-long-random-password

AZURITE_ACCOUNT_NAME=sitewatch
AZURITE_ACCOUNT_KEY=replace-with-a-base64-encoded-random-key

JWT_KEY=replace-with-at-least-32-random-bytes
JWT_EXPIRE_HOURS=12

GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587
GMAIL_EMAIL=replace-with-sender-email
GMAIL_SMTP_PASSWORD=replace-with-an-app-password
