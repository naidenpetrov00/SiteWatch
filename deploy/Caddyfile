{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

www.{$DASHBOARD_DOMAIN} {
	redir https://{$DASHBOARD_DOMAIN}{uri} permanent
}

{$DASHBOARD_DOMAIN} {
	encode zstd gzip
	import security_headers

	@assets path *.css *.js *.mjs *.png *.jpg *.jpeg *.gif *.svg *.webp *.woff *.woff2
	header @assets Cache-Control "public, max-age=31536000, immutable"

	route {
		root * /srv/dashboard
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache"
		file_server
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	import security_headers

	@mediamtx_internal path /internal/mediamtx /internal/mediamtx/*

	route {
		respond @mediamtx_internal 404
		reverse_proxy api:8080
	}
}

{$STREAM_DOMAIN} {
	import security_headers

	@whep {
		method OPTIONS POST PATCH DELETE
		path_regexp whep ^/.+/whep(?:/[^/]+)?$
	}

	route {
		reverse_proxy @whep mediamtx:8889
		respond 404
	}
}
